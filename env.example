# Expo will expose ONLY `EXPO_PUBLIC_*` variables to the app at runtime.

# Which environment the app should behave as:
# - development: enable dev-only shortcuts (like dev sign-in)
# - production: disable dev-only shortcuts
EXPO_PUBLIC_APP_ENV=development

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Reports App (Next.js)
EXPO_PUBLIC_REPORTS_APP_URL=http://localhost:3000