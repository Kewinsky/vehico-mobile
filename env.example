# Expo will expose ONLY `EXPO_PUBLIC_*` variables to the app at runtime.

# User-visible app name (home screen label, notifications, iOS permission strings via app.config.ts).
# Defaults to Vericar if unset.
# EXPO_PUBLIC_APP_DISPLAY_NAME=Vericar

# Which environment the app should behave as:
# - development: enable dev-only shortcuts (like dev sign-in)
# - production: disable dev-only shortcuts
EXPO_PUBLIC_APP_ENV=development

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Dev: http://localhost:3000 (do not use vehico.vercel.app; it has Vercel SSO and blocks public links).
# Production builds: https://www.vericar.pl
EXPO_PUBLIC_REPORTS_APP_URL=http://localhost:3000

# RevenueCat (required for production; optional in development – uses test key if unset)
# iOS App Store key (appl_...) or shared test key
# EXPO_PUBLIC_REVENUECAT_API_KEY=appl_xxx
# Android Google Play key (goog_...) – falls back to iOS key when unset
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_xxx