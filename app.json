{
  "expo": {
    "name": "Vericar",
    "slug": "vehico",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/splash-icon.png",
        "backgroundColor": "#000000"
      }
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "icon": "./assets/app-icon.png",
      "bundleIdentifier": "com.ktasoftware.vehico",
      "infoPlist": {
        "NSCameraUsageDescription": "Vericar needs camera access to capture and upload vehicle photos and attachments.",
        "NSPhotoLibraryUsageDescription": "Vericar needs photo library access to select and upload vehicle photos and attachments.",
        "NSPhotoLibraryAddUsageDescription": "Vericar may save exported images to your photo library when you choose to do so.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["en", "pl"]
          }
        }
      ],
      "expo-apple-authentication",
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon.png",
          "color": "#FFB803"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "vehico",
          "organization": "ktasoftware"
        }
      ],
      "react-native-bottom-tabs"
    ],
    "scheme": "vehico",
    "extra": {
      "eas": {
        "projectId": "cdb0e267-7fe1-48b4-bd44-5e6debb39f5f"
      }
    },
    "owner": "kta.software"
  }
}
